
# =====================================
# FLASK APPLICATION SECRET
# =====================================

FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET


# =====================================
# AES-256-GCM ENCRYPTION KEY
# =====================================

VAULTEX_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY


# =====================================
# HMAC-SHA256 INTEGRITY KEY
# =====================================

VAULTEX_INTEGRITY_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY


# =====================================
# HTTPS CONFIGURATION
# =====================================

VAULTEX_HTTPS=false
